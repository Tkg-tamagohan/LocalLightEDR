{
  "manifest_version": 3,
  "name": "LocalEDR Browser Shield",
  "version": "0.1.0",
  "description": "LocalEDR Browser Shield for DNR blocking, ClickFix/Pastejacking detection, NRD/homograph password warnings, and download origin tracking.",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "downloads",
    "nativeMessaging",
    "storage",
    "tabs",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LocalEDR Browser Shield"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_static",
        "enabled": true,
        "path": "rules/dnr_static.json"
      }
    ]
  }
}
